/**
 * 32-bit key histogram pass for the portable OHOS/mobile radix-sort path.
 * Derived from hist.comp, but intentionally avoids shaderInt64 requirements.
 */

#version 450
#extension GL_GOOGLE_include_directive : enable
#include "../shared_constants.glsl"

#define WORKGROUP_SIZE VKGS_WORKGROUP_SIZE
#define RADIX_SORT_BINS VKGS_RADIX_SORT_BINS

layout(local_size_x = WORKGROUP_SIZE) in;

layout(push_constant, std430) uniform PushConstants {
    uint g_num_elements;
    uint g_shift;
    uint g_num_workgroups;
    uint g_num_blocks_per_workgroup;
};

layout(std430, set = 0, binding = 0) buffer elements_in {
    uint g_elements_in[];
};

layout(std430, set = 0, binding = 1) buffer histograms {
    uint g_histograms[];
};

shared uint histogram[RADIX_SORT_BINS];

void main() {
    uint lID = gl_LocalInvocationID.x;
    uint wID = gl_WorkGroupID.x;

    if (lID < RADIX_SORT_BINS) {
        histogram[lID] = 0U;
    }
    barrier();

    for (uint index = 0; index < g_num_blocks_per_workgroup; index++) {
        uint elementId = wID * g_num_blocks_per_workgroup * WORKGROUP_SIZE + index * WORKGROUP_SIZE + lID;
        if (elementId < g_num_elements) {
            const uint bin = (g_elements_in[elementId] >> g_shift) & (RADIX_SORT_BINS - 1);
            atomicAdd(histogram[bin], 1U);
        }
    }
    barrier();

    if (lID < RADIX_SORT_BINS) {
        g_histograms[RADIX_SORT_BINS * wID + lID] = histogram[lID];
    }
}
