set(prefix "@CMAKE_CURRENT_BINARY_DIR@/external_consumer_install")
set(build "@CMAKE_CURRENT_BINARY_DIR@/external_consumer_build")

execute_process(
    COMMAND "@CMAKE_COMMAND@" --install "@CMAKE_BINARY_DIR@" --prefix "${prefix}"
    RESULT_VARIABLE install_result
)
if(NOT install_result EQUAL 0)
    message(FATAL_ERROR "Failed to install 3dgs package")
endif()

execute_process(
    COMMAND "@CMAKE_COMMAND@"
        -S "@CMAKE_CURRENT_SOURCE_DIR@/external_consumer"
        -B "${build}"
        -G "@CMAKE_GENERATOR@"
        "-DCMAKE_BUILD_TYPE=@CMAKE_BUILD_TYPE@"
        "-DCMAKE_PREFIX_PATH=${prefix}"
        "-DVulkan_INCLUDE_DIR=@Vulkan_INCLUDE_DIR@"
        "-DVulkan_LIBRARY=@Vulkan_LIBRARY@"
    RESULT_VARIABLE configure_result
)
if(NOT configure_result EQUAL 0)
    message(FATAL_ERROR "Failed to configure external 3dgs consumer")
endif()

execute_process(
    COMMAND "@CMAKE_COMMAND@" --build "${build}"
    RESULT_VARIABLE build_result
)
if(NOT build_result EQUAL 0)
    message(FATAL_ERROR "Failed to build external 3dgs consumer")
endif()
